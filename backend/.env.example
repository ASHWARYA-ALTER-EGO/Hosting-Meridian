# Lanmea backend env — copy to .env and fill in

# LLM provider
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Web search
TAVILY_API_KEY=tvly-...

# Database — SQLite locally, Postgres in prod
DATABASE_URL=sqlite:///./lanmea.db

# CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
