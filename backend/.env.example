# Meridian backend env — copy to .env and fill in

# LLM provider
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Web search
TAVILY_API_KEY=tvly-...

# Database — SQLite locally, Postgres in prod (Railway auto-injects a Postgres URL)
DATABASE_URL=sqlite:///./lanmea.db

# CORS — comma-separated origins the frontend will call from
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------- SECURITY
# Optional shared-secret. When set, all POST /api/profile requests must send
# `X-API-Key: <this value>`. Leave empty in local dev.  Set a long random
# string in production (e.g. `openssl rand -hex 32`) to stop strangers from
# burning your LLM budget.
API_KEY=
