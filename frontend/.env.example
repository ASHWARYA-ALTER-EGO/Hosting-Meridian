# Where the frontend calls the backend
VITE_API_BASE_URL=http://localhost:8000

# Optional. If your backend has API_KEY set, put the same value here so the
# frontend can send it as `X-API-Key`. Anyone with the deployed site can see
# this value in DevTools; it protects against random scripts, not motivated
# users. For a private demo, that's enough.
VITE_API_KEY=
